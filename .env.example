# ============================================================
# EaglerXProxy Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# Documentation: see DEPLOYMENT.md for detailed instructions

# ============================================================
# MINECRAFT SERVER CONFIGURATION (Required)
# ============================================================

# Your Minecraft server address (hostname or IP)
# Example: mc.example.com or 192.168.1.100
SERVER_HOST=127.0.0.1

# Your Minecraft server port (usually 25565)
SERVER_PORT=25565

# ============================================================
# PROXY LISTENING CONFIGURATION
# ============================================================

# Host address for proxy to listen on
# 0.0.0.0 = listen on all network interfaces
# 127.0.0.1 = listen only on localhost
BIND_HOST=0.0.0.0

# Port for the proxy WebSocket server
BIND_PORT=8080

# ============================================================
# PERSISTENT PROXY UUID CONFIGURATION (IMPORTANT)
# ============================================================

# Enable persistent proxy UUID/IP storage
# true = UUID stays the same across restarts (RECOMMENDED)
# false = New UUID generated on each restart
ENABLE_PERSISTENT_IP=true

# Directory where proxy persistence data is stored
# IMPORTANT: Use a persistent volume on cloud platforms!
# 
# Platform-specific paths:
#   - Local development: ./.proxy-data
#   - Docker/Docker Compose: /app/.proxy-data
#   - Netlify: /tmp/eagler-proxy (not truly persistent)
#   - Railway: /var/data/.proxy-data (use persistent disk)
#   - Render: /var/data/.proxy-data (use persistent disk)
#   - DigitalOcean: /var/data/.proxy-data (use persistent disk)
#
PROXY_PERSISTENCE_DIR=./.proxy-data

# ============================================================
# TLS/SSL CONFIGURATION (Optional - for HTTPS/WSS)
# ============================================================

# Enable TLS encryption for WebSocket connections (wss://)
# true = Use secure WebSocket (requires certificates)
# false = Use plain WebSocket (ws://)
ENABLE_TLS=false

# Path to TLS private key file
# Only required if ENABLE_TLS=true
# TLS_KEY=/path/to/server.key

# Path to TLS certificate file
# Only required if ENABLE_TLS=true
# TLS_CERT=/path/to/server.crt

# ============================================================
# LOGGING CONFIGURATION (Optional)
# ============================================================

# Log level: debug, info, warn, error
# debug = Very verbose output
# info = Normal operation logs
# warn = Warning messages only
# error = Error messages only
LOG_LEVEL=info

# ============================================================
# ADVANCED CONFIGURATION (Optional)
# ============================================================

# Maximum concurrent players allowed
# Default: 20 (adjust based on server capacity)
# MAX_PLAYERS=20

# Deployment platform auto-detection
# auto = Detect automatically
# netlify, heroku, railway, docker, local = Force specific platform
# DEPLOY_PLATFORM=auto

# ============================================================
# DEPLOYMENT PLATFORM SPECIFIC NOTES
# ============================================================

# GitHub Codespaces:
#   PROXY_PERSISTENCE_DIR=./.proxy-data
#   ENABLE_PERSISTENT_IP=true
#   Note: Data lost when Codespace is recreated

# Docker/Docker Compose:
#   PROXY_PERSISTENCE_DIR=/app/.proxy-data
#   Mount volume at /app/.proxy-data
#   ENABLE_PERSISTENT_IP=true

# Railway:
#   PROXY_PERSISTENCE_DIR=/app/.proxy-data
#   Add persistent volume: /app/.proxy-data
#   ENABLE_PERSISTENT_IP=true

# Render:
#   PROXY_PERSISTENCE_DIR=/var/data/.proxy-data
#   Add persistent disk at /var/data
#   ENABLE_PERSISTENT_IP=true

# DigitalOcean App Platform:
#   PROXY_PERSISTENCE_DIR=/var/data/.proxy-data
#   Add persistent volume at /var/data/.proxy-data
#   ENABLE_PERSISTENT_IP=true

# ============================================================
# COMMON PLATFORMS
# ============================================================

# For Railroad deployment:
# NODE_ENV=production
# ENABLE_PERSISTENT_IP=true

# For Heroku deployment (if still available):
# ENABLE_PERSISTENT_IP=true
# Note: Heroku's ephemeral filesystem means UUIDs change on redeploy

# For local Minecraft server testing:
# SERVER_HOST=localhost
# SERVER_PORT=25565
# PROXY_PERSISTENCE_DIR=./.proxy-data
